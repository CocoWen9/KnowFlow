{
  "name": "knowflow",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test",
    "test:db": "node --test tests/database*.test.js",
    "preview": "vite preview",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "worker:check": "wrangler deploy --dry-run --outdir .wrangler/check --config worker/wrangler.jsonc"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@xyflow/react": "12.4.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@vitejs/plugin-react": "4.3.4",
    "vite": "^5.4.21",
    "wrangler": "^4.147.0"
  }
}
